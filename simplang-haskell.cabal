cabal-version:      3.14
name:               simplang-haskell
version:            0.1.0.0
license:            NONE
author:             ueki5
maintainer:         ueki005@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common common-options
    ghc-options: -Wall
    default-language: GHC2024

library
    import:           common-options
    exposed-modules:  Compiler, CodeGen, Driver, Parser
    build-depends:    base >=4.20 && <4.21,
                      containers,
                      transformers,
                      mtl,
                      pretty-simple,
                      raw-strings-qq,
                      process,
                      text,
                      directory,
                      filepath,
    hs-source-dirs:   src

executable simplang-haskell
    import:           common-options
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.21,
        simplang-haskell,
        optparse-applicative,
        mtl,
        pretty-simple,
        raw-strings-qq,
    hs-source-dirs:   app

test-suite simplang-haskell-test
    import:           common-options
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base >=4.20 && <4.21,
        simplang-haskell,
        hspec,
        containers,
        directory,
        process,
        temporary,
        filepath,
        pretty-simple,
        text,
        QuickCheck,
        checkers
    hs-source-dirs:   test
